; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RoverEduCode"
run/main_scene="uid://dorjiuvlmgpes"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Supabase="*uid://8fusfri8k4ft"
GestorSintaxis="*res://script/services/gestor_sintaxis.gd"
ProgressService="*res://script/services/progress_service.gd"
AttemptService="*res://script/services/attempt_service.gd"
CursorManager="*res://script/services/cursor_manager.gd"
AudioManager="*res://script/audio_manager.gd"
CodeExecutor="*uid://dt8p6vupo2s3k"
MissionService="*uid://cc2d418sdsyc0"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RoverEduCode"

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://assets/tema_global.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
